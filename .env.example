# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# OpenRouter API (for AI extraction)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Odoo CRM Configuration
# Get a free trial at: https://www.odoo.com/trial (select CRM app)
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-email@example.com
ODOO_API_KEY=your-odoo-api-key

# Dev mode - set to true to skip actual Odoo calls
DEV_MODE=true

# Twilio WhatsApp (for production)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Desk access — extra allow-listed usernames (comma-separated).
# Django superusers (created with `python manage.py createsuperuser` or
# `python manage.py create_waleed`) can always sign in to the desk and /admin/;
# list a username here only when that account is NOT a superuser. The password
# itself is never stored here: create/rotate it with
#   python manage.py create_waleed --reset
POWR_ALLOWED_USERNAMES=waleed
